<Window x:Class="KosztyOgrzewania.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wyliczanie kosztów ogrzewania"
        Width="1100"
        Height="778"
        MinWidth="900"
        MinHeight="650"
        Background="#17191F"
        Foreground="#F3F5F7"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- Styles -->
        <!-- Override system brushes used by ComboBox popup to ensure dark dropdown -->
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1F2328"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1F2328"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#4F8CFF"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
        <!-- Gray text (used by disabled/placeholder text) -> ustaw jasny odcień, by był czytelny na ciemnym tle -->
        <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#BFC7D0"/>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#20232B"/>
            <Setter Property="BorderBrush" Value="#363B46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="22"/>
        </Style>
        <!-- Label -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#A8AFBA"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
        <!-- TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#F3F5F7"/>
            <Setter Property="Background" Value="#272B34"/>
            <Setter Property="BorderBrush" Value="#363B46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <!-- ComboBox - własny prosty szablon z ciemnym polem i ciemnym dropdownem -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F3F5F7"/>
            <Setter Property="Background" Value="#1F2328"/>
            <Setter Property="BorderBrush" Value="#363B46"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextElement.Foreground" Value="#F3F5F7"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <TextBlock x:Name="Text"
                                               Text="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource TemplatedParent}}"
                                               Margin="8,0,30,0"
                                               VerticalAlignment="Center"
                                               Foreground="{TemplateBinding Foreground}"/>
                                    <ToggleButton x:Name="DropDownToggle"
                                                  Width="28"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Stretch"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  Background="Transparent"
                                                  BorderThickness="0">
                                        <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                              Fill="#A8AFBA"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="#1F2328"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="PART_Popup" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox items appearance -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F3F5F7"/>
            <Setter Property="Background" Value="#1F2328"/>
            <Setter Property="Padding" Value="6,4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2E3338"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3A3F48"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Button -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#4F8CFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>

    <Grid Margin="34,34,38,14">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- NAGŁÓWEK -->
        <!-- ===================================================== -->

        <StackPanel Grid.Row="0">

            <TextBlock Text="Wyliczanie kosztów ogrzewania"
                       FontSize="30"
                       FontWeight="Bold"/>

            <TextBlock Text="Oblicz zużycie energii i porównaj koszt różnych surowców."
                       Foreground="#A8AFBA"
                       FontSize="14"
                       Margin="0,7,0,0"/>

        </StackPanel>


        <!-- ===================================================== -->
        <!-- DANE UŻYTKOWNIKA -->
        <!-- ===================================================== -->

        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Margin="0,25,0,18">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <!-- SUROWIEC -->

                <StackPanel Grid.Column="0"
                            Margin="0,0,18,0">

                    <Label Content="Aktualnie używany surowiec"/>
                    <ComboBox x:Name="CurrentFuelCombo"
                              SelectionChanged="FuelSelectionChanged"
                              DisplayMemberPath="DisplayName" Height="32"/>

                </StackPanel>


                <!-- ZUŻYCIE -->

                <StackPanel Grid.Column="1"
                            Margin="9,0,9,0">

                    <Label Content="Ilość zużytego surowca w ciągu roku"/>

                    <TextBox x:Name="QuantityTextBox"
                             Text="3000"/>

                </StackPanel>


                <!-- KOSZT -->

                <StackPanel Grid.Column="2"
                            Margin="18,0,0,0">

                    <Label Content="Ile wydaję na ogrzewanie w ciągu roku"/>

                    <TextBox x:Name="CostTextBox"
                             Text="3000"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- GŁÓWNA CZĘŚĆ -->
        <!-- ===================================================== -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="1.08*"/>
                <ColumnDefinition Width="0.92*"/>

            </Grid.ColumnDefinitions>


            <!-- ================================================= -->
            <!-- LEWA KARTA -->
            <!-- ================================================= -->

            <Border Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,10,0">

                <StackPanel>

                    <TextBlock Text="Straty energii"
                               FontSize="19"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Ustaw procent energii traconej podczas ogrzewania."
                               Foreground="#A8AFBA"
                               Margin="0,6,0,15"/>


                    <!-- SUWAK -->

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <Slider x:Name="LossSlider"
                                Minimum="0"
                                Maximum="50"
                                Value="15"
                                TickFrequency="5"
                                IsSnapToTickEnabled="False"
                                ValueChanged="LossSliderChanged"/>

                        <TextBlock x:Name="LossValueText"
                                   Grid.Column="1"
                                   Text="15%"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="18,0,0,0"/>

                    </Grid>


                    <!-- ENERGIA -->

                    <Border Background="#272B34"
                            CornerRadius="10"
                            Padding="15"
                            Margin="0,24,0,0">

                        <StackPanel>

                            <TextBlock Text="Energia z paliwa"
                                       Foreground="#A8AFBA"/>

                            <TextBlock x:Name="EnergyText"
                                       Text="—"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Margin="0,4,0,0"/>

                            <TextBlock Text="użyteczna energia po uwzględnieniu strat"
                                       Foreground="#A8AFBA"
                                       FontSize="12"
                                       Margin="0,4,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- PRZYCISK -->

                    <Button Content="OBLICZ"
                            Click="CalculateButton_Click"
                            Margin="0,25,0,0"
                            Height="48"/>

                </StackPanel>

            </Border>


            <!-- ================================================= -->
            <!-- PRAWA KARTA -->
            <!-- ================================================= -->

            <Border Grid.Column="1"
                    Style="{StaticResource CardStyle}"
                    Margin="10,0,0,0">

                <StackPanel>

                    <TextBlock Text="Porównaj z innym surowcem"
                               FontSize="19"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Sprawdź, ile potrzebujesz innego paliwa."
                               Foreground="#A8AFBA"
                               Margin="0,6,0,15"/>


                    <!-- DRUGI SUROWIEC -->

                    <Label Content="Surowiec docelowy"/>

                    <ComboBox x:Name="TargetFuelCombo"
                              DisplayMemberPath="DisplayName"
                              Margin="0,0,0,20" Height="30"/>


                    <!-- WYNIK -->

                    <Border Background="#272B34"
                            CornerRadius="10"
                            Padding="15">

                        <StackPanel>

                            <TextBlock Text="Potrzebna ilość"
                                       Foreground="#A8AFBA"/>

                            <TextBlock x:Name="TargetQuantityText"
                                       Text="—"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Margin="0,4,0,0"/>

                            <TextBlock x:Name="TargetCostText"
                                       Text="—"
                                       FontSize="16"
                                       Margin="0,8,0,0"/>

                        </StackPanel>

                    </Border>


                    <Separator Margin="0,22,0,18"
                               Background="#363B46"/>


                    <!-- SZCZEGÓŁY -->

                    <TextBlock Text="Szczegóły obliczenia"
                               FontSize="15"
                               FontWeight="SemiBold"/>


                    <Grid Margin="0,12,0,0">

                        <Grid.RowDefinitions>

                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>

                        </Grid.RowDefinitions>


                        <TextBlock Grid.Row="0"
                                   Text="Cena aktualnego paliwa"
                                   Foreground="#A8AFBA"/>

                        <TextBlock Grid.Row="0"
                                   x:Name="CurrentPriceText"
                                   HorizontalAlignment="Right"/>


                        <TextBlock Grid.Row="1"
                                   Text="Wartość energetyczna"
                                   Foreground="#A8AFBA"
                                   Margin="0,10,0,0"/>

                        <TextBlock Grid.Row="1"
                                   x:Name="CurrentEnergyValueText"
                                   HorizontalAlignment="Right"
                                   Margin="0,10,0,0"/>


                        <TextBlock Grid.Row="2"
                                   Text="Straty"
                                   Foreground="#A8AFBA"
                                   Margin="0,10,0,0"/>

                        <TextBlock Grid.Row="2"
                                   x:Name="CurrentLossText"
                                   HorizontalAlignment="Right"
                                   Margin="0,10,0,0"/>

                    </Grid>

                </StackPanel>

            </Border>

        </Grid>


        <!-- ===================================================== -->
        <!-- STOPKA -->
        <!-- ===================================================== -->

        <TextBlock Grid.Row="3"
                   Text="Dane surowców są pobierane z lokalnej bazy SQLite."
                   Foreground="#A8AFBA"
                   FontSize="12"
                   Margin="2,15,0,0"/>

    </Grid>

</Window>